# Mirrors .gitignore: keep Cursor from indexing local data, caches, and deps.
# Agents can still read these via explicit @-mentions.

# Local secrets and env
.env
.env.imported
packaging/bundle-auth.env
packaging/pro_invitees.txt

# Game catalogs and enrichment blobs (large, local-only)
games_*.json
games_wishlist_*.json
itad_prices.json
free_claims.json
broken_images.json
still_missing_images.json
_itad.json
_runs.json
free-claims.input.json

# Runtime / local state
cache/
data/
profiles/
%SystemDrive%/
.vercel/

# Tooling and deps
node_modules/
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
steam_backlog.egg-info/

# PyInstaller + frontend build outputs (very large, ~420MB+)
build/
dist/
release/

# Logs, test output, and server noise
refresh.log
enrich_hltb_run.log
.enrich_refresh.log
.server.err
.server.log
debug-*.log
.build-windows.log
srv.log
*.log
_sweep_output*.txt
pytest_*.txt
full_pytest_run.txt
.pytest-full.log
protondb_run.txt

# Temporary folders and files
tmp/
_tmp_*
_baseline_*
_tail_label.txt

