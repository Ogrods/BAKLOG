# BAKLOG — prefer the Connections tab in the dashboard. Connections encrypts
# credentials per-profile in cache/auth/secrets.bin (AES-GCM).

# Optional: enable the local maintainer admin dashboard at
# http://127.0.0.1:8765/admin/ (free-claims editor + job runner). Local-only,
# never shipped to end users. Comment out / set to 0 to disable, then restart.
# BAKLOG_ADMIN=1

# Optional: Supabase invite-only login (BAKLOG_SUPABASE_* in .env.example)
# BAKLOG_SUPABASE_URL=https://xxxx.supabase.co
# BAKLOG_SUPABASE_ANON_KEY=
# BAKLOG_SUPABASE_JWT_SECRET=   # optional legacy HS256; omit if project uses JWKS-only keys
# BAKLOG_AUTH_DISABLED=1       # skip auth and use normal local profile switcher
# BAKLOG_LOCAL_PROFILES=1      # with Supabase auth on: re-enable Work/Play profile switcher + PIN gate

#
# .env is legacy: on first server start, any credentials here are imported once
# into the DEFAULT profile's encrypted store and the file is archived as
# .env.imported. After that, manage credentials from the Connections page.

STEAM_API_KEY=your_32_character_hex_key_here
STEAM_ID=76561198000000000

# GOG session cookie (gog-al) from browser DevTools while signed in at gog.com
GOG_AL=

# Optional: free key from https://www.steamgriddb.com/profile/preferences/api for delisted game art
STEAMGRIDDB_KEY=

# PlayStation NPSSO token — get from https://ca.account.sony.com/api/v1/ssocookie while signed in
PSN_NPSSO=

# Epic: one-time auth code (NOT a cookie). Run: python fetch_epic.py --auth-help
EPIC_AUTH_CODE=

# Epic Store storefront cookie — used by fetch_epic_wishlist.py only.
# Sign in at https://store.epicgames.com, open the wishlist page, DevTools →
# Network → filter "graphql" → click any POST /graphql → Headers → Request
# Headers → copy the entire "Cookie:" header value (one long string).
EPIC_STORE_COOKIE=

# Amazon Games: optional override for launcher SQLite folder (Windows only).
# Default: %LOCALAPPDATA%\Amazon Games\Data\Games\Sql
# AMAZON_GAMES_SQL_DIR=

# IsThereAnyDeal — free key from https://isthereanydeal.com/dev/api/ (fetch_itad.py)
ITAD_API_KEY=
# ITAD storefront country (ISO 3166-1 alpha-2). Sets deal prices + display currency (default US).
# ITAD_COUNTRY=GB

# itch.io — generate at https://itch.io/user/settings/api-keys (fetch_itch.py)
ITCH_API_KEY=

# OpenXBL — free key from https://xbl.io/ (fetch_xbox.py)
XBL_API_KEY=

# Battle.net — unofficial. Modern Edge/Chrome (v127+) use app-bound cookie
# encryption, so the automatic jar read usually fails on Windows. Recommended:
# sign in at account.battle.net/games in Edge, DevTools → Network → reload →
# games-and-subs → copy the full Cookie: header → paste below (one line),
# then run: python fetch_battlenet.py --browser env --skip-hltb
BATTLENET_COOKIE=

# Optional: which browser's cookie jar to read. Default is "edge" but app-bound
# encryption usually blocks it on Windows; "env" (the recommended path) skips
# the jar entirely and uses BATTLENET_COOKIE above. Firefox is jar-readable
# without admin if you sign in there. Choices: edge, chrome, brave, firefox, env
# BATTLENET_BROWSER=env

# Ubisoft Connect — unofficial. Sign in at ubisoft.com or connect.ubisoft.com,
# DevTools → Network → filter "public-ubi" → click any request → Headers →
# scroll Request Headers and copy:
#   Authorization   (starts with "Ubi_v1 t=...")
#   Ubi-SessionId   (UUID)
# Optional: Ubi-AppId from the same request (defaults to ubisoft.com web app).
UBISOFT_AUTH=
UBISOFT_SESSION_ID=
# UBISOFT_APP_ID=

# Nintendo eShop — unofficial. Sign in at https://ec.nintendo.com/my/transactions/,
# DevTools → Network → filter "transactions" → click transactions?limit=… →
# copy the Cookie request header (fetch_nintendo.py). ~2 years of history only.
NINTENDO_COOKIE=
