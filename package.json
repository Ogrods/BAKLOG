{
  "name": "steam-backlog",
  "version": "0.6.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:js": "vitest run",
    "test:js:watch": "vitest",
    "test:all": "python -m pytest -q && npm test",
    "measure:baseline": "node scripts/measure-baseline.mjs",
    "compare:build": "node scripts/compare-build.mjs",
    "build:css": "node scripts/build-frontend.mjs --css-only",
    "build:js": "node scripts/build-frontend.mjs --js-only",
    "build": "node scripts/build-frontend.mjs",
    "landing": "python -m http.server 4000 --directory landing",
    "vendor:supabase": "esbuild node_modules/@supabase/supabase-js/dist/module/index.js --bundle --format=esm --outfile=js/vendor/supabase-js.mjs"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "axe-core": "^4.12.0",
    "esbuild": "^0.28.0",
    "happy-dom": "^20.9.0",
    "playwright": "^1.50.0",
    "vitest": "^3.0.0"
  }
}
