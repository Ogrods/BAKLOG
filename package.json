{
  "name": "steam-backlog",
  "version": "0.7.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:js": "vitest run",
    "test:js:watch": "vitest",
    "test:all": "python -m pytest -q && npm test",
    "measure:baseline": "node scripts/measure-baseline.mjs",
    "compare:build": "node scripts/compare-build.mjs",
    "build:css": "node scripts/build-frontend.mjs --css-only",
    "build:js": "node scripts/build-frontend.mjs --js-only",
    "build": "node scripts/build-frontend.mjs",
    "landing": "python -m http.server 4000 --directory landing",
    "check:spotlight:baseline": "node scripts/spotlight-visual-check.mjs --mode=baseline",
    "check:spotlight": "node scripts/spotlight-visual-check.mjs --mode=after",
    "vendor:supabase": "esbuild node_modules/@supabase/supabase-js/dist/module/index.js --bundle --format=esm --outfile=js/vendor/supabase-js.mjs",
    "lint": "eslint js/",
    "check:module-size": "node scripts/check-module-size.mjs",
    "check:bundle-size": "node scripts/check-bundle-size.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@supabase/supabase-js": "^2.49.1",
    "eslint": "^9.22.0",
    "eslint-plugin-import": "^2.31.0",
    "globals": "^16.0.0",
    "axe-core": "^4.12.0",
    "esbuild": "^0.28.0",
    "happy-dom": "^20.9.0",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.50.0",
    "pngjs": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
