# Copy to packaging/bundle-auth.env (gitignored) for release builds without
# reading repo-root .env. Only public auth keys belong here — never service_role.
#
# BAKLOG_SUPABASE_URL=https://xxxx.supabase.co
# BAKLOG_SUPABASE_ANON_KEY=sb_publishable_...   # or legacy eyJ... anon JWT if still enabled
# Do NOT put BAKLOG_SUPABASE_JWT_SECRET here - it must never ship in release zips.
# Frozen builds verify user JWTs via JWKS. Prefer publishable + secret API keys; omit JWT secret.
# BAKLOG_LOCAL_PROFILES=0       # optional; default off for hosted accounts
